cat > .gitignore << 'EOF'
# Dependencies
node_modules/
*/node_modules/

# Build outputs
dist/
build/
*/dist/
*/build/

# Environment variables (NEVER commit these!)
.env
.env.local
.env.production
.env.development
*/.env
*/.env.local
*/.env.production
*/.env.development

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Vite
.vite/
*/.vite/

# Coverage
coverage/

# Misc
.cache/
.temp/
.tmp/
EOF